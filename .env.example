# Public client configuration (safe to expose to the browser). Copy to .env.local.
# Leave both empty to run in local guided mode (no account, nothing uploaded).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secrets for the plan-attacks edge function. Set them in the Bolt / Supabase
# function secrets UI, never here and never with a VITE_ prefix:
#   XAI_API_KEY=            provider key for the optional metadata-only planner
#   ANALYSIS_LLM_MODEL=     provider model id chosen at deployment (not hard-coded)
# Injected by the platform into the function (do not set by hand):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# Public client configuration. Copy to .env.local. Never put server secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server secrets, entered in Bolt / Supabase function settings, never in this file's real copy:
# XAI_API_KEY=
# SUPABASE_URL and SUPABASE_ANON_KEY are injected into plan-attacks. Do not prefix them with VITE_.
